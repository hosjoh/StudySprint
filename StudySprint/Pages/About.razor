@page "/about"

<PageTitle>About | StudySprint</PageTitle>

<section class="page-card">
    <div class="page-heading">
        <p class="eyebrow">ABOUT</p>

        <h1>About StudySprint</h1>
    </div>

    <div class="about-section">
        <h2>Purpose</h2>

        <p>
            StudySprint is a study-session planner
            that helps students organize subjects,
            create short study goals, plan focused
            study sessions, and track their progress.
        </p>
    </div>

    <div class="about-section">
        <h2>Design Approach</h2>

        <p>
            StudySprint emphasizes short,
            structured sessions instead of complex
            project management. The goal is to
            reduce the amount of time students
            spend configuring a productivity tool.
        </p>
    </div>

    <div class="about-section">
        <h2>Design Tools</h2>

        <p>
            Figma is being used to plan interface
            wireframes, while Lucidchart is being
            used to map application structure and
            user flow. Visual Studio Community is
            used to develop and test the final
            Blazor WebAssembly application.
        </p>
    </div>
</section>