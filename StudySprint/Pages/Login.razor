@page "/login"

@using System.ComponentModel.DataAnnotations

@inject SupabaseService Supabase
@inject AppSession Session
@inject AuthStorageService AuthStorage
@inject NavigationManager Navigation

<PageTitle>Login | StudySprint</PageTitle>

@*
    StudySprint login page.

    Users authenticate through Supabase Auth.
    Successful login information is also stored in
    browser sessionStorage so login survives page reloads.
*@

<section class="login-wrapper">

    <div class="login-card">

        <p class="eyebrow">
            STUDYSPRINT
        </p>

        <h1>Welcome Back</h1>

        <p class="login-intro">
            Sign in to continue planning
            your study sessions.
        </p>

        @if (Session.IsLoggedIn)
        {
            <div class="success-message">
                You are signed in as
                <strong>@Session.Email</strong>.
            </div>

            <button type="button"
                    class="secondary-button"
                    @onclick="HandleLogout">

                Log Out

            </button>
        }
        else
        {
            <EditForm Model="_loginModel"
                      OnValidSubmit="HandleLogin">

                <DataAnnotationsValidator />

                <div class="form-group">

                    <label for="email">
                        Email Address
                    </label>

                    <InputText id="email"
                               class="form-control"
                               @bind-Value="_loginModel.Email" />

                    <ValidationMessage
                        For="@(() => _loginModel.Email)" />

                </div>

                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <InputText id="password"
                               type="password"
                               class="form-control"
                               @bind-Value="_loginModel.Password" />

                    <ValidationMessage
                        For="@(() => _loginModel.Password)" />

                </div>

                @if (!string.IsNullOrWhiteSpace(
                    _errorMessage))
                {
                    <div class="error-message">
                        @_errorMessage
                    </div>
                }

                <button type="submit"
                        class="primary-button"
                        disabled="@_isWorking">

                    @(_isWorking
                        ? "Signing In..."
                        : "Sign In")

                </button>

            </EditForm>

            <p class="login-register-link">
                Don't have an account?
                <a href="register">
                    Create one
                </a>
            </p>
        }

    </div>

</section>

@code {

    // Stores the values entered in the login form.
    private readonly LoginModel _loginModel =
        new();

    private bool _isWorking;

    private string _errorMessage =
        string.Empty;

    /// <summary>
    /// Authenticates the user through Supabase and
    /// stores the resulting session in memory and
    /// browser sessionStorage.
    /// </summary>
    private async Task HandleLogin()
    {
        _errorMessage =
            string.Empty;

        _isWorking =
            true;

        try
        {
            var result =
                await Supabase.SignInAsync(
                    _loginModel.Email.Trim(),
                    _loginModel.Password);

            if (!result.Success)
            {
                _errorMessage =
                    result.ErrorMessage ??
                    "Login could not be completed.";

                return;
            }

            Session.SignIn(
                result.UserId!,
                result.Email!,
                result.AccessToken!);

            await AuthStorage.SaveSessionAsync(
                result.UserId!,
                result.Email!,
                result.AccessToken!);

            /*
             * Do not use "/dashboard" here.
             *
             * A leading slash would navigate to:
             * https://hosjoh.github.io/dashboard
             *
             * Using "dashboard" respects the GitHub Pages
             * base path:
             * https://hosjoh.github.io/StudySprint/dashboard
             */
            Navigation.NavigateTo(
                "dashboard");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Login error: {ex}");

            _errorMessage =
                "StudySprint could not complete the login.";
        }
        finally
        {
            _isWorking =
                false;
        }
    }

    /// <summary>
    /// Signs the user out of the active StudySprint
    /// session and removes stored browser session data.
    /// </summary>
    private async Task HandleLogout()
    {
        Session.SignOut();

        await AuthStorage.ClearSessionAsync();

        _loginModel.Email =
            string.Empty;

        _loginModel.Password =
            string.Empty;

        _errorMessage =
            string.Empty;

        Navigation.NavigateTo(
            "login");
    }

    /// <summary>
    /// Represents the values entered into the login form.
    /// </summary>
    private sealed class LoginModel
    {
        [Required(
            ErrorMessage =
                "Email is required.")]
        [EmailAddress(
            ErrorMessage =
                "Enter a valid email address.")]
        public string Email { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Password is required.")]
        public string Password { get; set; } =
            string.Empty;
    }
}